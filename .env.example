# FleetFocus Environment Configuration Example
# Copy this file to .env and fill in real values before starting the backend.

# Database Configuration
DB_URL=jdbc:mysql://localhost:3306/fleetfocus_dbs?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=replace_with_your_db_password

# JWT Configuration (Must be a Base64-encoded secret of at least 32 decoded bytes / 256 bits)
# Generate with: openssl rand -base64 32
JWT_SECRET=replace_with_base64_encoded_256bit_secret
JWT_EXPIRATION_MS=86400000

# CORS Allowed Origins (comma-separated)
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,http://localhost:63342

# Business Rules
TRIP_OVERDUE_HOURS=8

# Optional Development Seeder (only active when SPRING_PROFILES_ACTIVE=dev)
SPRING_PROFILES_ACTIVE=dev
SEED_ADMIN_PASSWORD=replace_with_dev_admin_password
SEED_DISPATCHER_PASSWORD=replace_with_dev_dispatcher_password
SEED_DRIVER_PASSWORD=replace_with_dev_driver_password
